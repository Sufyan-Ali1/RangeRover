      "@type": "FAQPage",
      "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq",
      "url": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq",
      "name": "Range Rover Evoque Engine Repair Specialists — FAQs",
      "isPartOf": {
        "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#webpage"
      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq-question-1",
          "name": "Why does my Range Rover Evoque keep overheating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Overheating in the Evoque is most commonly linked to a coolant leak from the thermostat housing, water pump or intercooler pipework on Ingenium engines. Left unresolved, it can lead to head gasket failure, so we recommend having it diagnosed as soon as warning signs appear."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq-question-2",
          "name": "Is the Range Rover Evoque a reliable car overall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Evoque is well-regarded for driving experience and design, though early Ingenium engines have a known pattern of coolant-related issues. With proactive maintenance and prompt repairs, most owners run their Evoque reliably for years."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq-question-3",
          "name": "How much does an Evoque engine replacement typically cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs vary depending on whether a rebuild, reconditioned unit or full replacement is required, and whether it's the Si4 petrol or TD4 diesel engine. We provide a fixed, itemised quote after diagnosis so you know the exact cost before agreeing to any work."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq-question-4",
          "name": "What are the most common Evoque engine problems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most frequently reported issues are coolant leaks, overheating, thermostat housing failure and, in some cases, timing chain wear. Early diagnosis usually keeps repair costs to a fraction of what a neglected fault can eventually cost."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq-question-5",
          "name": "Do you work on both the Si4 petrol and TD4 diesel Evoque?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our technicians work on both the Si4 2.0 petrol and TD4 2.2 diesel Ingenium engines across first and second generation Evoque models, including the Convertible variant."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq-question-6",
          "name": "Can I get an Evoque engine repair quote before booking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, get in touch with your Evoque's symptoms and mileage, and we'll advise on likely causes and next steps. A fixed quote is confirmed once we've carried out a full diagnostic on the vehicle."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/evoque#faq-question-7",
          "name": "Do you collect vehicles that aren't local to your workshop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer collection and delivery for Evoque owners across the UK, so you don't need to be based near our Grays workshop to use our engine repair service."
          }
        }
      ]
