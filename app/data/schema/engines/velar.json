      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-1",
          "name": "Is the Range Rover Velar reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Overall reliability is reasonable, though certain Ingenium engines have been linked to known issues such as oil dilution and timing chain tensioner wear. Regular servicing and prompt attention to warning signs go a long way toward keeping the Velar dependable."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-2",
          "name": "What engines does the Velar use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Velar is available with 2.0-litre Ingenium petrol and diesel engines, badged variants such as D240 and P250, alongside the more powerful 3.0-litre SDV6 diesel and supercharged petrol V6, including the P380."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-3",
          "name": "Does the Velar have Ingenium timing chain issues?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some early Ingenium engines have experienced timing chain tensioner wear, often signalled by rattling on cold start. It's a known concern we check for during diagnostics, and early intervention typically prevents more serious damage."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-4",
          "name": "How much does a Velar engine replacement cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on the engine variant and the cause of the failure. We provide a fixed, written quote after inspecting the vehicle, so you know the full cost before any work begins."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-5",
          "name": "What is oil dilution and does it affect the Velar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oil dilution occurs when unburned diesel enters the engine oil during regeneration cycles, most commonly affecting cars used mainly for short journeys. It can reduce lubrication over time, so we check for it as part of our standard Velar diagnostic."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-6",
          "name": "Do you collect the vehicle or do I need to bring it in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer nationwide collection and delivery, so you don't need to be near our workshop to have your Velar repaired. You're also welcome to drop the car off yourself if that's more convenient."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-7",
          "name": "Is there a warranty on reconditioned or replacement engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every reconditioned and replacement engine we supply and fit is covered by a warranty, giving you added confidence in the work carried out."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/velar#faq-question-8",
          "name": "How long does a Velar engine repair or replacement take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most repairs and replacements are completed within one to two weeks, depending on the fault and parts availability. We'll give you an accurate timeframe once we've inspected your vehicle."
          }
        }
      ]
