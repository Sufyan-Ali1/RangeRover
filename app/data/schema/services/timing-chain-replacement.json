      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-chain-replacement#faq-question-1",
          "name": "How much does a Range Rover timing chain replacement cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs vary depending on model, engine type and the extent of damage, since some repairs also involve tensioners, guides or gaskets. We provide a fixed, transparent quote only after a full diagnostic inspection, so you know exactly what you're paying for."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-chain-replacement#faq-question-2",
          "name": "What are the symptoms of a failing timing chain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common warning signs include a rattling or slapping noise on cold start, a check engine light, rough idling and reduced engine performance. Left unaddressed, a worn timing chain can jump time and cause serious internal engine damage."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-chain-replacement#faq-question-3",
          "name": "How long does timing chain replacement take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most Range Rover and Land Rover timing chain replacements take between one and three days, depending on engine access and whether tensioners or guides also need replacing. We confirm an accurate timeframe after inspection."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-chain-replacement#faq-question-4",
          "name": "Can I still drive with a rattling timing chain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We don't recommend it. A rattling chain indicates wear that worsens over time, and continuing to drive risks the chain skipping or snapping, which can cause expensive and sometimes irreparable engine damage."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-chain-replacement#faq-question-5",
          "name": "Do all Range Rovers have timing chain problems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not every model or engine is affected equally, but certain diesel and supercharged petrol engines are more prone to chain, tensioner and guide wear. Regular inspection helps catch issues early, before they become costly repairs."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-chain-replacement#faq-question-6",
          "name": "Do you offer a warranty on timing chain repairs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every timing chain replacement we carry out is covered by a 12-month parts and labour warranty, reflecting our confidence in genuine components and the quality of our workmanship on every vehicle."
          }
        }
      ]
