    {
      "@type": "FAQPage",
      "@id": "https://rangerovergarage.co.uk/engines#faq",
      "url": "https://rangerovergarage.co.uk/engines#faq",
      "name": "Reconditioned Range Rover and Land Rover Engines, Tested Before They Reach You — FAQs",
      "isPartOf": {
        "@id": "https://rangerovergarage.co.uk/engines#webpage"
      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines#faq-question-1",
          "name": "How much does a reconditioned Range Rover engine typically cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pricing depends on the model, engine type and whether you choose supply only or supply and fit. We provide a clear, itemised quote once we've confirmed your vehicle details, so you know the full cost before committing to anything."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines#faq-question-2",
          "name": "What's the difference between a reconditioned and a remanufactured engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A reconditioned engine has worn components inspected, repaired or replaced as needed, while a remanufactured engine is rebuilt to strict factory specification with all wear parts renewed. Remanufactured units generally offer a longer expected lifespan as a result."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines#faq-question-3",
          "name": "Do used or reconditioned Land Rover engines come with a warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every engine we supply, whether reconditioned or remanufactured, is covered by warranty as standard. Full terms are explained clearly before purchase, covering both the unit itself and our fitting workmanship where applicable."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines#faq-question-4",
          "name": "How long does an engine replacement typically take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most replacements are completed within about a week, depending on engine availability and vehicle complexity. We'll confirm a realistic timeframe once we've matched the correct engine to your specific model and booked the work in."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines#faq-question-5",
          "name": "Can I buy an engine without having it fitted by you?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer both supply only and full supply and fit options. If you have your own trusted fitter, we can simply supply the tested engine directly, though we're always happy to handle the complete job if preferred."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines#faq-question-6",
          "name": "Do you offer collection if I'm not local to your Grays workshop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we provide UK-wide collection and delivery, so your location doesn't limit access to our engine sourcing and fitting service. Simply share your address when booking and we'll arrange the logistics from there."
          }
        }
      ]
