      "@type": "FAQPage",
      "@id": "https://rangerovergarage.co.uk/engines/land-rover#faq",
      "url": "https://rangerovergarage.co.uk/engines/land-rover#faq",
      "name": "Land Rover Engines, Sourced by Model — FAQs",
      "isPartOf": {
        "@id": "https://rangerovergarage.co.uk/engines/land-rover#webpage"
      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover#faq-question-1",
          "name": "What engines are available across the Discovery, Freelander and Defender ranges?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Land Rover has used a wide variety of engines across its model lines, including Td5, 300Tdi, TDV6, SDV6, TD4, K-series petrol and modern Ingenium diesel and petrol units. The exact engine depends heavily on model, generation and year, not just the badge on the back of the vehicle."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover#faq-question-2",
          "name": "How do I identify which engine my Land Rover Discovery has?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most reliable way is to check your V5 logbook or share your registration with our team, who can confirm the exact engine code for you. This prevents the common mistake of ordering a part based on model name alone, which can easily be the wrong variant."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover#faq-question-3",
          "name": "Which Land Rover engine is generally considered most reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reliability varies significantly by generation and maintenance history rather than one engine being universally best. The Td5 earned a strong reputation for durability, while later Ingenium units have generally improved reliability over some earlier diesel platforms when serviced correctly."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover#faq-question-4",
          "name": "Are Freelander and Discovery engines interchangeable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, Freelander and Discovery models use distinctly different engine platforms, even where model years overlap. Attempting to fit a Freelander engine into a Discovery, or vice versa, typically isn't feasible without extensive and costly modification, so always confirm compatibility before sourcing parts."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover#faq-question-5",
          "name": "Can you supply an engine for an older Discovery or Freelander?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we regularly source and fit engines for older platforms, including classic Discovery 1 and 2 models alongside newer generations. Availability can vary by age and rarity, so it's best to confirm your exact model and engine code with our team directly."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover#faq-question-6",
          "name": "Do you fit the engine yourselves or just supply the part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer both options. You can choose supply only if you have your own trusted fitter, or full supply and fit, where our specialist engineers handle the complete installation and testing process in-house."
          }
        }
      ]
