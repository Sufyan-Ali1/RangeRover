      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/turbo-replacement#faq-question-1",
          "name": "How much does a Range Rover turbo replacement cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pricing depends on your engine, whether reconditioning is possible, and whether related components like the wastegate or actuator also need attention. We confirm a fixed, transparent quote once full diagnostics are complete."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/turbo-replacement#faq-question-2",
          "name": "What are the signs of a failing turbo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common symptoms include a high-pitched whining noise, noticeable loss of power, blue or grey exhaust smoke, and increased oil consumption. A dashboard warning light can also appear as the fault develops."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/turbo-replacement#faq-question-3",
          "name": "Can a turbo be reconditioned instead of replaced?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In many cases, yes. If the core housing is undamaged, we can recondition the internal components rather than fitting a full replacement, which often reduces cost while restoring proper performance."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/turbo-replacement#faq-question-4",
          "name": "How long does turbo replacement take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most turbo replacements or reconditioning jobs are completed within one to two working days, depending on engine access and parts availability. We confirm an exact timeframe once diagnostics are finished."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/turbo-replacement#faq-question-5",
          "name": "Can I keep driving with a faulty turbo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We wouldn't recommend it. A failing turbo can send debris into the engine or cause oil starvation, so continuing to drive risks turning a turbo repair into a much larger engine repair bill."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/turbo-replacement#faq-question-6",
          "name": "Do you offer a warranty on turbo repairs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every turbo replacement and reconditioning job is covered by a 12-month parts and labour warranty, giving you confidence in both the components used and the work carried out."
          }
        }
      ]
