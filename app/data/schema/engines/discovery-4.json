      "@type": "FAQPage",
      "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq",
      "url": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq",
      "name": "Land Rover Discovery 4 Engine Specialists — FAQs",
      "isPartOf": {
        "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#webpage"
      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-1",
          "name": "Is the Land Rover Discovery 4 reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Widely regarded as one of the more dependable Discovery generations, particularly on later SDV6 and SDV8 diesels. Early TDV6 and SDV6 units carry a known crankshaft failure risk, so servicing history and prompt attention to warning signs matter significantly."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-2",
          "name": "Why does the Discovery 4 suffer crankshaft failure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Crankshaft failure is typically caused by bearing wear that allows excessive movement within the engine, most associated with early TDV6 and SDV6 diesel units. It's a known issue we check for as standard during diagnostics on affected engine variants."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-3",
          "name": "Which is better: TDV6, SDV8 or 5.0 V8?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Each suits a different priority. The TDV6 and SDV6 offer efficiency, the SDV8 provides strong towing performance, and the 5.0 V8 delivers smooth, refined power at the cost of higher running expenses. We can advise based on your specific use case."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-4",
          "name": "How much does an engine rebuild cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost varies significantly depending on the engine variant and the extent of the work required. We provide a fixed, written quote after inspection, so you know the full cost before any work is authorised."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-5",
          "name": "Which engines did the Discovery 4 use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Discovery 4, known as the LR4 in North America, was offered with the 3.0-litre TDV6 and later SDV6 diesels, the 4.4-litre SDV8 diesel, and a 5.0-litre naturally aspirated petrol V8."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-6",
          "name": "Do you collect the vehicle or do I need to bring it in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer nationwide collection and delivery, so distance from our workshop isn't a barrier to getting your Discovery 4 properly assessed. You're also welcome to drop the vehicle off yourself."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-7",
          "name": "Is there a warranty on reconditioned or replacement engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every reconditioned and replacement engine we supply and fit is covered by a warranty, giving you confidence in the work carried out."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-4#faq-question-8",
          "name": "How long does a Discovery 4 engine repair or replacement take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most repairs and replacements are completed within one to two weeks, depending on the engine variant and parts availability. We'll confirm an accurate timeframe once we've inspected your vehicle."
          }
        }
      ]
