      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-1",
          "name": "Why does the Land Rover Discovery 3 suffer crankshaft failure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Crankshaft failure on the 2.7 TDV6 is typically caused by bearing wear that allows excessive play within the engine, eventually leading to metal-to-metal contact. It's a known issue on this engine generation, particularly on higher-mileage examples with inconsistent servicing history."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-2",
          "name": "Is the Discovery 3 2.7 TDV6 reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The TDV6 is a capable engine overall, but it carries a known risk of crankshaft failure that owners should be aware of. With regular oil changes and prompt attention to knocking noises or oil pressure warnings, many TDV6 engines run reliably for years."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-3",
          "name": "What are the symptoms of crankshaft failure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common warning signs are a knocking or rumbling noise from the engine, particularly under load, along with a drop in oil pressure that can trigger a dashboard warning light. Either symptom should prompt an immediate diagnostic inspection."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-4",
          "name": "How much does an engine replacement cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on whether a full replacement engine is needed or whether a partial repair is viable, which we determine through diagnostic testing. We provide a fixed quote after inspection, so you know the full cost before work begins."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-5",
          "name": "Which engines did the Discovery 3 use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Discovery 3 was offered with the 2.7-litre TDV6 diesel alongside 4.0-litre and 4.4-litre V8 petrol engines, known in North America as the LR3. Each engine has its own specific maintenance considerations."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-6",
          "name": "Do you collect the vehicle or do I need to bring it in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer nationwide collection and delivery, so distance from our workshop isn't a barrier to getting your Discovery 3 properly assessed. You're also welcome to drop the vehicle off yourself."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-7",
          "name": "Is there a warranty on reconditioned or replacement engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every reconditioned and replacement engine we supply and fit is covered by a warranty, giving you confidence in the work carried out."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-3#faq-question-8",
          "name": "How long does a TDV6 engine repair or replacement take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most repairs and replacements are completed within one to two weeks, depending on the extent of the damage and parts availability. We'll confirm an accurate timeframe once we've inspected your vehicle."
          }
        }
      ]
