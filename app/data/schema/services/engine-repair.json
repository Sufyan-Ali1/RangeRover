      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-repair#faq-question-1",
          "name": "How much does Range Rover engine repair cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends entirely on the fault found during diagnostics, since repairs can range from a minor sensor replacement to a major component fix. We provide a fixed quote only after confirming the actual cause."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-repair#faq-question-2",
          "name": "What are common Range Rover engine problems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Frequent issues include timing chain rattle, turbo whine, head gasket failure, and general fault codes triggered by sensors or emissions components. A proper diagnostic check identifies which of these applies to your vehicle."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-repair#faq-question-3",
          "name": "Can all engine faults be repaired?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most faults can be repaired rather than requiring full replacement, provided damage hasn't progressed too far. We always explain whether repair, rebuild or replacement offers the best value for your specific situation."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-repair#faq-question-4",
          "name": "How do I know what's wrong with my engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Warning lights, unusual noises, smoke or performance changes are all indicators, but the exact cause needs proper diagnostic equipment to confirm. Guessing based on symptoms alone often leads to unnecessary repairs."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-repair#faq-question-5",
          "name": "Is it worth repairing an older Range Rover engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In many cases, yes, since a targeted repair is usually far cheaper than a replacement engine. We assess the vehicle's overall condition and give you an honest recommendation either way."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-repair#faq-question-6",
          "name": "Do you offer a warranty on engine repairs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every engine repair we complete is covered by a 12-month parts and labour warranty, giving you confidence that the fault has been properly resolved, not just temporarily patched."
          }
        }
      ]
