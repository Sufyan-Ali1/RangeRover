      "@type": "FAQPage",
      "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq",
      "url": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq",
      "name": "Land Rover Discovery 2 Engine Specialists — FAQs",
      "isPartOf": {
        "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#webpage"
      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-1",
          "name": "Why do Discovery 2 head gaskets fail?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Head gasket failure on the Td5 is commonly linked to cooling system inefficiencies that create localised hot spots around the cylinder head. Over time, this can cause the gasket to break down, allowing coolant or oil to mix or leak into the cylinders."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-2",
          "name": "Is the Land Rover Td5 engine reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Td5 is a capable and well-liked engine, but it has known weaknesses around head gasket failure and, on some examples, injector wear. With proper maintenance and prompt attention to warning signs, many Td5 engines cover very high mileages reliably."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-3",
          "name": "What are common Td5 engine problems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Alongside head gasket failure, the Td5 can experience EDC ECU faults, injector wear, and swirl flap issues on some models. Accurate diagnosis is important, as several of these faults can present with similar symptoms."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-4",
          "name": "How much does a Td5 engine rebuild cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on the extent of the damage and whether cooling system components need replacing alongside the gasket itself. We provide a fixed quote after inspection, so you know the full cost before any work is authorised."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-5",
          "name": "What are signs of a failing Discovery 2 head gasket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common signs include white smoke from the exhaust, unexplained coolant loss, overheating, and a mayonnaise-like residue under the oil filler cap. Any of these symptoms should be checked promptly to avoid more serious engine damage."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-6",
          "name": "Do you collect the vehicle or do I need to bring it in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer nationwide collection and delivery, so distance from our workshop isn't a barrier to getting your Discovery 2 properly repaired. You're also welcome to drop the vehicle off yourself."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-7",
          "name": "Is there a warranty on reconditioned or replacement engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every reconditioned and replacement engine we supply and fit is covered by a warranty, giving you confidence in the work carried out."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-2#faq-question-8",
          "name": "How long does a Td5 head gasket repair take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most head gasket repairs are completed within a few days, though timescales can extend if cooling system components or other faults are identified during inspection. We'll confirm an accurate timeframe once we've assessed your vehicle."
          }
        }
      ]
