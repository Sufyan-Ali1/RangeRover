      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-1",
          "name": "How much does it cost to rebuild a Range Rover engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs vary depending on the model, engine type and extent of damage. We provide a free, itemised quote after diagnostics, so you know exactly what you're paying for before any work begins."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-2",
          "name": "Is it worth rebuilding a Range Rover engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most cases, yes. A professional rebuild costs significantly less than a full engine replacement and, when done correctly, restores performance and reliability to near-factory condition."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-3",
          "name": "Who repairs Range Rover engines near me?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We collect and deliver vehicles UK-wide, meaning wherever you're based, our specialist engineers can carry out your rebuild or repair without you needing to visit our workshop in person."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-4",
          "name": "How long does an engine rebuild take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most rebuilds are completed within 7 to 14 working days, depending on parts availability and the complexity of the fault. We'll confirm a realistic timeline once diagnostics are complete."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-5",
          "name": "Are Range Rover engines reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Modern Range Rover engines are generally dependable when serviced correctly, though certain models are prone to specific faults like timing chain wear. Regular maintenance significantly reduces the risk of major failure."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-6",
          "name": "What's the difference between reconditioned and remanufactured engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reconditioned engines have worn components repaired or replaced, while remanufactured engines are rebuilt to strict factory specification with all wear parts renewed, typically offering a longer-lasting result."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-7",
          "name": "Do you offer a warranty on rebuilt or replacement engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every rebuild, repair and supplied engine comes with warranty cover as standard, giving you protection and peace of mind long after your vehicle is returned."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk#faq-question-8",
          "name": "Do you collect vehicles or do I need to bring it in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer UK-wide collection and delivery, so you never need to arrange your own transport or take time off work to bring your vehicle to us."
          }
        }
      ]
