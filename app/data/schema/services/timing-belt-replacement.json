      "@type": "FAQPage",
      "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq",
      "url": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq",
      "name": "Range Rover Timing Belt Replacement Before It Becomes an Emergency — FAQs",
      "isPartOf": {
        "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#webpage"
      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq-question-1",
          "name": "How often should a Range Rover timing belt be replaced?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most belt-driven Land Rover diesel engines require replacement every 90,000 to 105,000 miles or a set number of years, whichever comes first. We confirm the exact interval for your specific engine code."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq-question-2",
          "name": "What happens if a timing belt snaps?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On interference engines, a snapped belt allows pistons and valves to collide, causing severe internal damage. This typically results in a major, costly repair rather than a straightforward belt replacement."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq-question-3",
          "name": "Does my Range Rover have a belt or a chain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the engine. Many newer models use timing chains, while older TD5 and TD4 diesel engines are belt-driven. We confirm your exact setup before recommending any service."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq-question-4",
          "name": "How much does timing belt replacement cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on your engine and whether a water pump replacement is carried out alongside. We provide a fixed quote covering the full kit once your model and mileage are confirmed."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq-question-5",
          "name": "Is it worth replacing the water pump at the same time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in most cases. Since the water pump is often driven by the same belt and requires similar access, replacing both together saves on future labour costs and reduces overall risk."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/timing-belt-replacement#faq-question-6",
          "name": "Do you offer a warranty on timing belt replacement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every timing belt service we carry out is covered by a 12-month parts and labour warranty, covering the full kit and any additional components fitted during the service."
          }
        }
      ]
