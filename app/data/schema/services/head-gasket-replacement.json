      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/head-gasket-replacement#faq-question-1",
          "name": "What are the symptoms of a blown head gasket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common signs include white smoke from the exhaust, milky or discoloured oil, frequent coolant loss, overheating, and a sweet smell from the engine bay. Any combination of these signals a gasket fault needing urgent attention."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/head-gasket-replacement#faq-question-2",
          "name": "Can I still drive with a blown head gasket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We strongly advise against it. Continuing to drive risks coolant mixing with oil, cylinder head warping, and eventual engine seizure, turning a manageable repair into a far more expensive rebuild or replacement."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/head-gasket-replacement#faq-question-3",
          "name": "How much does head gasket replacement cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on your engine, the extent of damage, and whether the cylinder head needs skimming or replacing. We confirm a fixed, transparent price after full diagnostic and compression testing."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/head-gasket-replacement#faq-question-4",
          "name": "How long does head gasket replacement take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most repairs take between two and four working days, depending on cylinder head condition and cooling system inspection results. We'll give you an accurate timeframe once diagnostics are complete."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/head-gasket-replacement#faq-question-5",
          "name": "Is it cheaper to repair the head gasket or replace the engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most cases, a head gasket repair is significantly more cost-effective than an engine replacement, provided the fault is caught early before serious internal damage occurs from prolonged overheating."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/head-gasket-replacement#faq-question-6",
          "name": "Do you offer a warranty on head gasket repairs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every head gasket replacement we carry out is covered by a 12-month parts and labour warranty, reflecting the thorough testing and genuine components used throughout the repair."
          }
        }
      ]
