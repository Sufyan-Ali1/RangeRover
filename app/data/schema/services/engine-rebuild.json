      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-rebuild#faq-question-1",
          "name": "How much does a Range Rover engine rebuild cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs vary depending on the engine type, extent of damage and parts required. After a full inspection, we provide a fixed, itemised quote so you know the exact cost before any work begins."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-rebuild#faq-question-2",
          "name": "How long does a Range Rover engine rebuild take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most rebuilds take between one and two weeks, depending on parts availability and the condition found during strip-down. We'll confirm a realistic timeframe once your engine has been inspected."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-rebuild#faq-question-3",
          "name": "Is rebuilding cheaper than replacing the engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In many cases, a rebuild costs significantly less than a full engine replacement while restoring the same reliability. We'll walk you through both options so you can compare value against your vehicle's mileage."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-rebuild#faq-question-4",
          "name": "What's included in a full engine rebuild?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A full rebuild includes complete strip-down, inspection, replacement of pistons, bearings, gaskets and seals, reassembly to factory tolerances, and dyno testing before your vehicle is returned to you."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-rebuild#faq-question-5",
          "name": "Do you offer nationwide collection and delivery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we collect and deliver vehicles across the UK, so you don't need to be local to Grays to use our engine rebuild service."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-rebuild#faq-question-6",
          "name": "What warranty comes with a rebuilt engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every rebuild includes a written workmanship warranty covering parts and labour. Full terms are explained clearly before work starts, so you know exactly what's covered."
          }
        }
      ]
