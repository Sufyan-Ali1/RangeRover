      "@type": "FAQPage",
      "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq",
      "url": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq",
      "name": "Land Rover Discovery 1 Engine Specialists — FAQs",
      "isPartOf": {
        "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#webpage"
      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-1",
          "name": "Is the Land Rover Discovery 1 200Tdi reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 200Tdi has a strong reputation for durability when properly maintained, with many examples covering well over 200,000 miles. Common issues tend to relate to age-related wear, such as head gaskets and injection pump seals, rather than fundamental design faults."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-2",
          "name": "What V8 engines did the Discovery 1 use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Discovery 1 was fitted with Rover V8 petrol engines ranging from 3.5 to 3.9 litres, with later models receiving the 4.0-litre GEMS-managed unit. Each variant has slightly different characteristics and known wear points."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-3",
          "name": "Can you still get parts for a Discovery 1 engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Parts availability for the Discovery 1's Tdi diesels and Rover V8 remains strong thanks to sustained enthusiast demand, and we maintain supplier relationships built up over years of working on this generation of vehicle."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-4",
          "name": "How much does a Discovery 1 engine rebuild cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on the engine type and its condition, particularly on V8s where cylinder wall integrity needs assessing. We provide a fixed quote after inspection, so you know the full cost before any work is authorised."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-5",
          "name": "What causes cylinder wall cracking in the Rover V8?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Repeated overboring during previous rebuilds can thin the cylinder walls over time, increasing the risk of cracking under load. We check block condition carefully before recommending a rebuild approach on any V8-powered Discovery 1."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-6",
          "name": "Is the 200Tdi a good engine to rebuild?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the 200Tdi is a relatively straightforward and rewarding engine to rebuild, with good parts availability and a well-understood design. Proper attention to injection timing and gasket integrity is essential for a lasting result."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-7",
          "name": "Do you collect the vehicle or do I need to bring it in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer nationwide collection and delivery, so distance from our workshop isn't a barrier to getting your Discovery 1 properly assessed. You're also welcome to drop the vehicle off yourself."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/land-rover/discovery-1#faq-question-8",
          "name": "Is there a warranty on reconditioned or replacement engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every reconditioned and replacement engine we supply and fit is covered by a warranty, giving you added confidence in the work carried out."
          }
        }
      ]
