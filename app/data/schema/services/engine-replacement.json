      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-replacement#faq-question-1",
          "name": "How much does a Range Rover engine replacement cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on your specific model, engine type, and whether a genuine or reconditioned unit is used. We provide an instant estimate from your registration, followed by a fixed quote after inspection."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-replacement#faq-question-2",
          "name": "Is it worth replacing the engine or buying a new car?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most cases, replacement is significantly cheaper than buying another vehicle once deposits, finance and depreciation are considered. We're happy to walk you through a direct cost comparison for your situation."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-replacement#faq-question-3",
          "name": "How long does an engine replacement take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most replacements are completed within five to seven working days, depending on engine sourcing and ancillary transfer complexity. We confirm an accurate timeframe once your vehicle has been assessed."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-replacement#faq-question-4",
          "name": "What warranty comes with a replacement engine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every replacement engine we fit is covered by a 12-month parts and labour warranty, giving you confidence in both the unit itself and the quality of the fitting work carried out."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-replacement#faq-question-5",
          "name": "What's the difference between engine replacement and rebuild?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Replacement involves fitting a different genuine or reconditioned engine, while a rebuild repairs and restores your existing engine internally. We'll recommend whichever option offers better value for your specific vehicle."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/services/engine-replacement#faq-question-6",
          "name": "Do you source genuine or reconditioned engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use both, depending on availability and your budget. Every unit is checked for compatibility and condition before fitting, and fully tested afterwards to confirm reliable performance."
          }
        }
      ]
