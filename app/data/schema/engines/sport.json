      },
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/sport#faq-question-1",
          "name": "Why does my Range Rover Sport use so much oil?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Excessive oil consumption is a well-documented issue on early L320 Sport models, often linked to piston ring or valve seal wear. It's worth having checked promptly, as prolonged low oil levels can cause further engine damage over time."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/sport#faq-question-2",
          "name": "What causes timing chain rattle in the Range Rover Sport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A rattling noise, usually most noticeable on cold starts, is typically caused by a stretched timing chain or worn tensioner. This is most common on earlier TDV6 and SDV6 engines and should be inspected before it affects engine timing."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/sport#faq-question-3",
          "name": "Is the Range Rover Sport a reliable vehicle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Later generations are notably more reliable than early L320 models, which carry known oil consumption and timing chain concerns. With regular maintenance and early attention to warning signs, most Sport owners get many reliable years from their vehicle."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/sport#faq-question-4",
          "name": "How much does a Range Rover Sport engine rebuild cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs depend on the generation, engine type and extent of the damage found during diagnosis. We provide a fixed, itemised quote once we've inspected your vehicle, so you know the full cost before any work begins."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/sport#faq-question-5",
          "name": "Do you work on all Range Rover Sport generations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our technicians repair engines across the L320, L494 and L461 generations, including TDV6, SDV6, SDV8 diesel units and the AJ133 supercharged petrol engine."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/sport#faq-question-6",
          "name": "Can I get a repair quote before booking my vehicle in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, tell us your Sport's symptoms, mileage and generation, and we'll advise on the likely cause. A confirmed fixed quote follows a full diagnostic once the vehicle is with us."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/range-rover/sport#faq-question-7",
          "name": "Do you collect vehicles from outside your local area?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer UK-wide collection and delivery, so you can use our engine repair service regardless of how far you are from our Grays workshop."
          }
        }
      ]
