      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/jaguar#faq-question-1",
          "name": "What engines does the Jaguar F-Pace use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The F-Pace has been fitted with Ingenium diesel and petrol engines across most trims, alongside the supercharged AJ133 V8 in SVR variants. The exact engine depends on model year and trim level, so it's worth confirming your specific code before ordering any parts."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/jaguar#faq-question-2",
          "name": "Do Jaguar and Land Rover share the same engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, many Jaguar models use Ingenium and AJ133 engine platforms that are also fitted across Land Rover and Range Rover vehicles. This shared engineering means specialists experienced with one brand's engines are typically well placed to work confidently on the other."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/jaguar#faq-question-3",
          "name": "Is the Jaguar Ingenium engine considered reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ingenium engines are generally dependable when serviced correctly, though like any engine family they have known issues to watch for, including timing chain wear on certain variants. Regular maintenance and prompt attention to early symptoms significantly reduce the risk of major failure."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/jaguar#faq-question-4",
          "name": "How much does a Jaguar engine replacement typically cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs vary depending on the model, engine type and whether repair or full replacement is required. We provide a clear, itemised quote after diagnostics, so you know exactly what you're paying for before any work begins."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/jaguar#faq-question-5",
          "name": "Which Jaguar engine is considered the most reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reliability depends heavily on maintenance history and generation rather than one engine being universally best. Later Ingenium updates have generally improved on earlier reliability concerns, though consistent servicing remains the biggest factor in long-term dependability."
          }
        },
        {
          "@type": "Question",
          "@id": "https://rangerovergarage.co.uk/engines/jaguar#faq-question-6",
          "name": "Can you collect my Jaguar if I'm not local to your workshop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer UK-wide collection and delivery, so your location doesn't limit access to our specialist engine service. Simply share your address when booking and we'll arrange the logistics from there."
          }
        }
      ]
